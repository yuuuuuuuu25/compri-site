---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { siteConfig } from '@/config/site';
import { sitePath } from '@/lib/paths';

const faqs = [
  ['Can I use Compri anonymously?', 'Yes. Compri creates an anonymous account when you first use the app and stores your records in the cloud. If you lose the anonymous session, however, you may be unable to recover that account.'],
  ['Can I link Sign in with Apple later?', 'Yes. You can link Sign in with Apple to your anonymous account and then use the corresponding Apple account to sign in.'],
  ['What can the other household member see?', 'Both members can see the sharing display name each person chose and can view and edit the items, stores, prices, quantities, units, and record dates stored in that household. Compri does not copy an Apple account name or email into that display name.'],
  ['Are photos uploaded?', 'No. OCR uses Apple Vision on your device. The source image is not uploaded to Compri or Supabase. Values you confirm and save are stored as price records.'],
  ['Why can the widget be out of date?', 'The widget displays a limited snapshot stored on your device. It may temporarily differ from the latest data in the app.'],
  ['Does signing out delete my data?', 'No. Signing out and deleting an account are different actions. Use the in-app account deletion feature when you want the account and eligible data deleted.'],
];
---

<BaseLayout lang="en" title="Support" description="Frequently asked questions, contact details, and account deletion guidance for Compri.">
  <PageHeader eyebrow="Support" title="How can we help?" lead="Answers about accounts, household sharing, image recognition, widgets, and data deletion." />
  <div class="support-body">
    <section>
      <p class="eyebrow">01 / Frequently asked questions</p>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details><summary>{question}<span aria-hidden="true">＋</span></summary><p>{answer}</p></details>
        ))}
      </div>
    </section>
    <section class="cta-grid">
      <article>
        <p class="eyebrow">02 / Account deletion</p>
        <h2>Review what gets deleted.</h2>
        <p>The steps differ depending on your role in a shared household.</p>
        <a href={sitePath('/en/account-deletion/')}>View deletion guide →</a>
      </article>
      <article>
        <p class="eyebrow">03 / Contact</p>
        {siteConfig.supportEmail ? (
          <><h2>Contact support.</h2><a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a></>
        ) : (
          <><h2>Contact details are being prepared.</h2><p>The official support email address will be added before publication.</p></>
        )}
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .support-body { padding-bottom: 7rem; }
  .support-body > section { padding: 3rem 0; border-top: 1px solid var(--line); }
  .faq-list { max-width: 820px; margin-left: auto; }
  details { border-top: 1px solid var(--line); }
  details:first-child { border-top: 0; }
  summary { display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem 0; cursor: pointer; font-weight: 750; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { display: inline-block; color: var(--accent); font-size: 1.2rem; }
  details[open] summary span { transform: rotate(45deg); }
  details p { margin: -.25rem 2rem 1.25rem 0; color: var(--ink-muted); }
  .cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .cta-grid article { min-height: 190px; display: flex; align-items: flex-start; flex-direction: column; padding: 1.5rem 0; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line); }
  .cta-grid h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .cta-grid article > p:not(.eyebrow) { color: var(--ink-muted); }
  .cta-grid a { margin-top: auto; color: var(--accent); font-weight: 800; text-decoration: none; }
  @media (max-width: 700px) { .cta-grid { grid-template-columns: 1fr; } }
</style>
